# The app reopens SECURITY_LOG on every append, so a plain rename/create rotation is safe.
/var/log/screentinker/security.log {
    weekly
    maxsize 10M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    # No owner/group: the new file keeps the old one's, so the non-root service can still append.
    create 0640
}
